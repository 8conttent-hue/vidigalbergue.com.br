---
import { getPosts } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';

const PER_PAGE = 6;
// Traz o acervo uma vez e pagina em memoria: ORDER BY/range no banco
// estoura o statement_timeout do Postgres.
const all = await getPosts(100);
const totalPages = Math.max(1, Math.ceil(all.length / PER_PAGE));
const current = Math.min(Math.max(1, Number(Astro.url.searchParams.get('page')) || 1), totalPages);
const posts = all.slice((current - 1) * PER_PAGE, current * PER_PAGE);
const pageUrl = (n: number) => (n === 1 ? '/blog' : `/blog?page=${n}`);

const prev = current > 1 ? current - 1 : null;
const next = current < totalPages ? current + 1 : null;
---
<BaseLayout
  title={current > 1 ? `Blog — Página ${current}` : 'Blog'}
  description="Todos os artigos e publicações do blog."
>
  <Header />

  <section class="py-16 bg-gray-50 min-h-screen">
    <div class="max-w-6xl mx-auto px-4">
      <!-- Header -->
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-primary mb-3 block">Blog</span>
        <h1 class="text-4xl md:text-5xl font-black text-dark">Todos os Artigos</h1>
      </div>

      <!-- Grid de posts -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => (
          <article class="group bg-white rounded-2xl overflow-hidden border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all">
            <div class="aspect-video bg-gradient-to-br from-primary/10 to-accent/5 overflow-hidden">
              {post.featured_image && (
                <img
                  src={post.featured_image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              )}
            </div>
            <div class="p-5">
              <div class="text-xs font-bold text-primary uppercase tracking-widest mb-2">
                Artigo
              </div>
              <h2 class="font-bold text-dark leading-snug mb-3 group-hover:text-primary transition-colors">
                <a href={`/${post.slug}`}>{post.title}</a>
              </h2>
              <p class="text-sm text-gray-500 line-clamp-2 mb-4">{post.meta_description}</p>
              <div class="flex items-center justify-between text-xs text-gray-400">
                <span>Equipe Editorial</span>
                <span>{new Date(post.published_at).toLocaleDateString('pt-BR')}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      {all.length === 0 && (
        <div class="text-center py-20 text-gray-400">
          <p class="text-xl">Nenhum artigo publicado ainda.</p>
        </div>
      )}

      <!-- Paginacao -->
      {totalPages > 1 && (
        <nav class="flex items-center justify-center gap-2 mt-12" aria-label="Paginacao dos artigos">
          {prev && (
            <a
              href={pageUrl(prev)}
              class="px-4 py-2 rounded-xl bg-white border border-gray-200 text-sm font-bold text-dark hover:border-primary hover:text-primary transition-colors"
            >
              ← Anterior
            </a>
          )}

          {Array.from({ length: totalPages }, (_, i) => i + 1).map(n => (
            <a
              href={pageUrl(n)}
              aria-current={n === current ? 'page' : undefined}
              class={`min-w-10 px-3 py-2 rounded-xl text-sm font-bold border transition-colors ${
                n === current
                  ? 'bg-primary text-white border-primary'
                  : 'bg-white border-gray-200 text-dark hover:border-primary hover:text-primary'
              }`}
            >
              {n}
            </a>
          ))}

          {next && (
            <a
              href={pageUrl(next)}
              class="px-4 py-2 rounded-xl bg-white border border-gray-200 text-sm font-bold text-dark hover:border-primary hover:text-primary transition-colors"
            >
              Proxima →
            </a>
          )}
        </nav>
      )}
    </div>
  </section>

  <Footer />
</BaseLayout>
