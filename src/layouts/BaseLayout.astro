---
import siteConfig from '../data/siteConfig.json';
import Seo from '../components/Seo.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  author?: string;
  publishedTime?: string;
}

const {
  title,
  description,
  image,
  type = 'website',
  author,
  publishedTime,
} = Astro.props;

const pageTitle = title ? title : siteConfig.name;
const pageDesc = description || siteConfig.description || '';
const fontUrl = siteConfig.fontUrl || '';
const colors = (siteConfig as any).colors || { primary: '#3b82f6', accent: '#10b981', dark: '#0f172a' };
const fontFamily = siteConfig.fontFamily || 'system-ui, sans-serif';
const isSidebar = (siteConfig as any).components?.header === 'Header-D';
---
<!DOCTYPE html>
<html lang="pt-BR" class={isSidebar ? 'has-sidebar' : ''}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <Seo
    title={pageTitle}
    description={pageDesc}
    image={image}
    type={type}
    author={author}
    publishedTime={publishedTime}
  />

  <style is:global define:vars={{ primary: colors.primary, accent: colors.accent, dark: colors.dark, fontFamily }}>
    :root {
      --primary: var(--primary);
      --accent: var(--accent);
      --dark: var(--dark);
      --font-family: var(--fontFamily);
    }
  </style>

  <!-- Google Fonts -->
  {fontUrl && (
    <>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link rel="stylesheet" href={fontUrl} />
    </>
  )}
</head>
<body>
  <slot />
</body>
</html>